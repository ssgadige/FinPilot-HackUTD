# Configuration names only. Never commit actual values.
APP_URL=http://localhost:3000
DATABASE_PATH=./data/finpilot-demo.sqlite
DEMO_MODE=true
# Server-only. Confirm exact model access and tool support before implementing.
NVIDIA_API_KEY=
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=
# Random server secrets; generate locally following SETUP.md.
